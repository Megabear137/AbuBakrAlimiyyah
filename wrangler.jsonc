// The site is static files served by Cloudflare Workers (static assets),
// built from the `production` branch. Without this file a bare
// `wrangler deploy` no longer knows what to publish. Non-site files are
// kept off the live site by .assetsignore.
{
  "name": "abubakr",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "."
  }
}
